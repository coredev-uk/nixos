# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# athena's Windows dev tools, apart from gaming.winget. Mirrors Sona's CI Windows build
# (.github/actions/setup-windows): Go, MinGW-w64 gcc, pkg-config, GStreamer at the pin, the
# MSVC-built CDM shim, same env vars.
properties:
  configurationVersion: 0.2.0
  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives: { description: Git for Windows (Git Bash runs Sona's build scripts), securityContext: elevated, allowPrerelease: true }
      settings: { id: Git.Git, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: gh
      directives: { description: GitHub CLI, securityContext: elevated, allowPrerelease: true }
      settings: { id: GitHub.cli, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: go
      directives: { description: Go, securityContext: elevated, allowPrerelease: true }
      settings: { id: GoLang.Go, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: mingw
      directives: { description: "MinGW-w64 gcc for cgo (WinLibs, UCRT)", allowPrerelease: true }
      settings: { id: BrechtSanders.WinLibs.POSIX.UCRT, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkg-config
      directives: { description: pkg-config-lite (CI's pkgconfiglite), allowPrerelease: true }
      settings: { id: bloodrock.pkg-config-lite, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: nsis
      directives: { description: NSIS (build/windows/package.sh), securityContext: elevated, allowPrerelease: true }
      settings: { id: NSIS.NSIS, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: golangci-lint
      directives: { description: golangci-lint, allowPrerelease: true }
      settings: { id: GolangCI.golangci-lint, source: winget }
    # Sona's `just` commands. Portable package: winget refuses user scope from elevated, so machine-wide.
    - resource: PSDscResources/Script
      id: just
      directives: { description: just, securityContext: elevated, allowPrerelease: true }
      settings:
        GetScript: |
          @{ Result = ((winget list --id Casey.Just -e --disable-interactivity --accept-source-agreements) -join "`n") }
        TestScript: |
          [bool]((winget list --id Casey.Just -e --disable-interactivity --accept-source-agreements) -match 'Casey\.Just')
        SetScript: |
          winget install --id Casey.Just -e --scope machine --silent --accept-package-agreements --accept-source-agreements --disable-interactivity
          if ($LASTEXITCODE) { throw "winget install Casey.Just failed ($LASTEXITCODE)" }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives: { description: Visual Studio Code, allowPrerelease: true }
      settings: { id: Microsoft.VisualStudioCode, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: t3code
      directives: { description: T3 Code (home/common/programs/t3code.nix), allowPrerelease: true }
      settings: { id: T3Tools.T3Code, source: winget }
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vs-buildtools
      directives: { description: Visual Studio 2022 Build Tools, securityContext: elevated, allowPrerelease: true }
      settings: { id: Microsoft.VisualStudio.2022.BuildTools, source: winget }
    # C++ x64 tools for build/windows/build-shim.sh (found via vswhere).
    - resource: Microsoft.VisualStudio.DSC/VSComponents
      id: vs-cpp
      dependsOn: [vs-buildtools]
      directives: { description: MSVC C++ build tools, securityContext: elevated, allowPrerelease: true }
      settings:
        productId: Microsoft.VisualStudio.Product.BuildTools
        channelId: VisualStudio.17.Release
        includeRecommended: true
        components:
          - Microsoft.VisualStudio.Workload.VCTools

    - resource: PSDscResources/Script
      id: vscode-extensions
      dependsOn: [vscode]
      directives: { description: VS Code extensions, allowPrerelease: true }
      settings:
        GetScript: |
          $code = "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd"
          @{ Result = ((& $code --list-extensions) -join ' ') }
        TestScript: |
          $code = "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd"
          $have = & $code --list-extensions
          $want = 'golang.go', 'ms-vscode-remote.remote-wsl', 'jnoortheen.nix-ide', 'mkhl.direnv', 'timonwong.shellcheck'
          -not ($want | Where-Object { $have -notcontains $_ })
        SetScript: |
          $code = "$env:LOCALAPPDATA\Programs\Microsoft VS Code\bin\code.cmd"
          $want = 'golang.go', 'ms-vscode-remote.remote-wsl', 'jnoortheen.nix-ide', 'mkhl.direnv', 'timonwong.shellcheck'
          foreach ($e in $want) { & $code --install-extension $e }

    # Go extension's tools.
    - resource: PSDscResources/Script
      id: go-tools
      dependsOn: [go]
      directives: { description: "gopls, gofumpt, dlv", allowPrerelease: true }
      settings:
        GetScript: |
          @{ Result = ((Get-ChildItem "$env:USERPROFILE\go\bin" -ErrorAction SilentlyContinue).Name -join ' ') }
        TestScript: |
          -not ('gopls', 'gofumpt', 'dlv' | Where-Object { -not (Test-Path "$env:USERPROFILE\go\bin\$_.exe") })
        SetScript: |
          $go = "$env:ProgramFiles\Go\bin\go.exe"
          foreach ($p in 'golang.org/x/tools/gopls', 'mvdan.cc/gofumpt', 'github.com/go-delve/delve/cmd/dlv') {
            & $go install "$p@latest"
            if ($LASTEXITCODE) { throw "go install $p failed" }
          }

    # Checkout (%USERPROFILE%\Projects\sona-go), GStreamer at build/windows/gstreamer.sha256's
    # version, and sona_cdm_shim.dll, in %LOCALAPPDATA%\sona-dev. A new pin reinstalls GStreamer.
    # Clones over SSH, so Proton Pass must be unlocked.
    - resource: PSDscResources/Script
      id: sona-dev
      dependsOn: [git, vs-cpp]
      directives: { description: "sona-go checkout, GStreamer and the CDM shim", allowPrerelease: true }
      settings:
        GetScript: |
          $gst = "$env:LOCALAPPDATA\sona-dev\gstreamer\bin\gst-launch-1.0.exe"
          @{ Result = if (Test-Path $gst) { [string](& $gst --version | Select-Object -Last 2 | Select-Object -First 1) } else { '' } }
        TestScript: |
          $d = "$env:LOCALAPPDATA\sona-dev"
          $repo = "$env:USERPROFILE\Projects\sona-go"
          $gst = "$d\gstreamer\bin\gst-launch-1.0.exe"
          if (-not (Test-Path "$repo\.git") -or -not (Test-Path $gst) -or -not (Test-Path "$d\shim\sona_cdm_shim.dll")) { return $false }
          $want = (Select-String -Path "$repo\build\windows\gstreamer.sha256" -Pattern '^version (\S+)').Matches[0].Groups[1].Value
          # "GStreamer 1.28.8 (GIT)"
          [bool]((& $gst --version) -match "^GStreamer $([regex]::Escape($want))( |$)")
        SetScript: |
          $d = ("$env:LOCALAPPDATA\sona-dev") -replace '\\', '/'
          $repo = "$env:USERPROFILE\Projects\sona-go"
          $git = "$env:ProgramFiles\Git\cmd\git.exe"
          # Stderr progress counts as failure to the Script resource: log it, trust only exit codes.
          $log = "$env:LOCALAPPDATA\sona-dev\setup.log"
          New-Item -ItemType Directory -Force (Split-Path $log) | Out-Null
          function Run($file, $arguments, $what) {
            $p = Start-Process $file -ArgumentList $arguments -Wait -PassThru -NoNewWindow -RedirectStandardError $log
            if ($p.ExitCode) { throw "$what failed ($($p.ExitCode)): $(Get-Content $log -Raw)" }
          }
          if (-not (Test-Path "$repo\.git")) {
            New-Item -ItemType Directory -Force (Split-Path $repo) | Out-Null
            Run $git @('clone', 'https://github.com/coredev-uk/sona-go', "`"$repo`"") 'git clone'
            # Linux devenv's enterShell equivalent: hooks refusing commits on main.
            Run $git @('-C', "`"$repo`"", 'config', 'core.hooksPath', '.githooks') 'git config'
          }
          $r = $repo -replace '\\', '/'
          Run "$env:ProgramFiles\Git\bin\bash.exe" @('-lc', "`"cd '$r' && GSTREAMER_PKG_CACHE='$d/gstreamer-pkg' build/windows/install-gstreamer.sh '$d/gstreamer' && build/windows/build-shim.sh '$d/shim'`"") 'install-gstreamer.sh or build-shim.sh'
          Remove-Item $log

    # Pinned so `winget upgrade --all` keeps GStreamer at the repo's version.
    - resource: PSDscResources/Script
      id: gstreamer-pin
      dependsOn: [sona-dev]
      directives: { description: Pin GStreamer in winget, allowPrerelease: true }
      settings:
        GetScript: |
          @{ Result = ((winget pin list --disable-interactivity) -join "`n") }
        TestScript: |
          [bool]((winget pin list --disable-interactivity) -match 'gstreamerproject\.gstreamer')
        SetScript: |
          winget pin add --id gstreamerproject.gstreamer --blocking --disable-interactivity

    # Env for cgo and CDM tests. Git Bash's /etc/profile overrides PKG_CONFIG_PATH; ~/.bashrc resets it.
    - resource: PSDscResources/Script
      id: sona-env
      dependsOn: [sona-dev, pkg-config]
      directives: { description: User environment for Sona's cgo build, allowPrerelease: true }
      settings:
        GetScript: |
          @{ Result = [Environment]::GetEnvironmentVariable('GSTREAMER_ROOT', 'User') }
        TestScript: |
          $d = "$env:LOCALAPPDATA\sona-dev"
          $pc = (Get-ChildItem "$env:LOCALAPPDATA\Microsoft\WinGet\Packages\bloodrock.pkg-config-lite_*\*\bin\pkg-config.exe" | Select-Object -First 1).FullName
          $want = @{
            GSTREAMER_ROOT  = "$d\gstreamer" -replace '\\', '/'
            PKG_CONFIG_PATH = "$d\gstreamer\sona-pkgconfig" -replace '\\', '/'
            PKG_CONFIG      = $pc -replace '\\', '/'
            SONA_CDM_SHIM   = "$d\shim\sona_cdm_shim.dll"
            CGO_ENABLED     = '1'
            GOFLAGS         = '-tags=sqlite_fts5'
          }
          $path = [Environment]::GetEnvironmentVariable('Path', 'User') -split ';'
          -not ($want.Keys | Where-Object { [Environment]::GetEnvironmentVariable($_, 'User') -ne $want[$_] }) -and
            ($path -contains "$d\gstreamer\bin") -and ($path -contains "${env:ProgramFiles(x86)}\NSIS")
        SetScript: |
          $d = "$env:LOCALAPPDATA\sona-dev"
          $pc = (Get-ChildItem "$env:LOCALAPPDATA\Microsoft\WinGet\Packages\bloodrock.pkg-config-lite_*\*\bin\pkg-config.exe" | Select-Object -First 1).FullName
          $want = @{
            GSTREAMER_ROOT  = "$d\gstreamer" -replace '\\', '/'
            PKG_CONFIG_PATH = "$d\gstreamer\sona-pkgconfig" -replace '\\', '/'
            PKG_CONFIG      = $pc -replace '\\', '/'
            SONA_CDM_SHIM   = "$d\shim\sona_cdm_shim.dll"
            CGO_ENABLED     = '1'
            GOFLAGS         = '-tags=sqlite_fts5'
          }
          foreach ($k in $want.Keys) { [Environment]::SetEnvironmentVariable($k, $want[$k], 'User') }
          $path = [Environment]::GetEnvironmentVariable('Path', 'User')
          foreach ($p in "$d\gstreamer\bin", "${env:ProgramFiles(x86)}\NSIS") {
            if (($path -split ';') -notcontains $p) { $path = "$p;$path" }
          }
          [Environment]::SetEnvironmentVariable('Path', $path, 'User')
