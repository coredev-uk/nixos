+uint32_t CScreencopyPortal::onSwitchSource() {
+    Debug::log(LOG, "[screencopy] SwitchSource");
+
+    std::vector<Hyprutils::Memory::CWeakPointer<SSession>> sharing;
+    for (const auto& session : m_vSessions) {
+        // Workspace shares run on image-copy-capture, set up once in startSharing.
+        if (session->sharingData.active && session->selection.type != TYPE_WORKSPACE)
+            sharing.emplace_back(session->self);
+    }
+
+    if (sharing.empty()) {
+        Debug::log(LOG, "[screencopy] SwitchSource: no switchable share");
+        return 0;
+    }
+
+    // Blocks the loop like SelectSources does: the shares hold their last frame while the picker is up.
+    SSelectionData selection = promptForScreencopySelection();
+
+    if (selection.type == TYPE_WORKSPACE) {
+        Debug::log(ERR, "[screencopy] SwitchSource: can't switch a running share to a workspace");
+        selection.type = TYPE_INVALID;
+    } else if (selection.type == TYPE_WINDOW && !m_sState.toplevel) {
+        Debug::log(ERR, "[screencopy] SwitchSource: window selected without the toplevel export protocol");
+        selection.type = TYPE_INVALID;
+    }
+
+    if (selection.type == TYPE_INVALID)
+        return 0;
+
+    uint32_t switched = 0;
+    for (const auto& session : sharing) {
+        if (!session || !session->sharingData.active)
+            continue;
+
+        // Drop the frame in flight from the old source; the next frame's buffer info renegotiates
+        // the stream if the size or format changed, as a resized window does.
+        m_pPipewire->removeSessionFrameCallbacks(session.get());
+
+        const bool ALLOWTOKEN         = session->selection.allowToken;
+        session->selection            = selection;
+        session->selection.allowToken = ALLOWTOKEN;
+
+        const auto PSTREAM = m_pPipewire->streamFromSession(session.get());
+        if (PSTREAM && PSTREAM->streamState)
+            startFrameCopy(session.get());
+
+        ++switched;
+    }
+
+    Debug::log(LOG, "[screencopy] SwitchSource: switched {} share(s) to selection {}", switched, (int)selection.type);
+    return switched;
+}
